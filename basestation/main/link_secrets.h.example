#ifndef LINK_SECRETS_H
#define LINK_SECRETS_H

// Copy this file to link_secrets.h (gitignored) and fill in real values
// before building. Both this file's values and the FC's
// main/config_link_secrets.h must agree (same PMK/LMK on both sides, and
// each side's peer MAC must be the OTHER device's real MAC).
//
// ESP-NOW's encrypted peer entries must be unicast -- a broadcast peer can't
// be encrypted. That means both devices' real MAC addresses need to be known
// ahead of time:
//   1. Flash each board once (this basestation firmware already logs its own
//      STA MAC at boot via esp_wifi_get_mac(WIFI_IF_STA, mac), right after
//      esp_wifi_init() -- see main/wifi_ap.c -- so a normal boot with a
//      placeholder link_secrets.h is enough to read it off the serial
//      monitor; no separate throwaway firmware needed).
//   2. Note both MACs down.
//   3. Fill in CONFIG_LINK_PEER_MAC below with the FC's MAC.
//   4. Reflash the basestation with this file in place.
// The FC side does the mirror image with this basestation's MAC (see
// main/config_link_secrets.h.example in the FC project).

// Wi-Fi channel both devices communicate on. Must match the FC's value. Note
// this is also the channel the basestation's own AP is started on (ESP32
// AP+STA shares one radio/channel), so the phone will associate to the
// basestation on this channel too.
#define CONFIG_LINK_WIFI_CHANNEL (6)

// 16-byte primary master key, used to encrypt the LMK exchange. Pick any 16
// bytes; must match the FC's config_link_secrets.h exactly.
#define CONFIG_LINK_PMK { 'C','h','a','n','g','e','M','e','1','6','B','y','t','e','s','!' }

// 16-byte local master key for this peer's encrypted link. Must match the
// FC's config_link_secrets.h exactly.
#define CONFIG_LINK_LMK { 'C','h','a','n','g','e','M','e','T','o','o','1','6','B','y' }

// The FC's real STA MAC address (see step 1-2 above).
#define CONFIG_LINK_PEER_MAC { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

#endif // LINK_SECRETS_H
