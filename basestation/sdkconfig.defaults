# Basestation targets a generic ESP32-S3 devkit (4MB flash is the common
# minimum for these boards; adjust if your specific board differs). The
# embedded web UI assets (Leaflet + our HTML/JS/CSS, ~180KB) plus the AP+STA
# WiFi/HTTP server/ESP-NOW code need more room than the FC's 2MB/"single app"
# layout, hence the larger partition table here.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table (see partitions.csv) rather than either stock
# single-app choice: the regular one (partitions_singleapp.csv, 1M factory)
# leaves the embedded web UI assets almost no headroom (~4% free at time of
# writing); the "large" one (partitions_singleapp_large.csv, 1500K factory)
# builds a bootloader that overflows its fixed IRAM region on this toolchain
# for reasons unrelated to app partition size. This custom table matches the
# regular one's offsets/bootloader config exactly and just gives the factory
# partition more room (1920K).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# esp_http_server: default max_uri_handlers (8) is too small for this
# project's route count (static assets + /api/*); bumped in http_server.c's
# httpd_config_t instead of here, but URI length may exceed the default for
# long query-less paths -- 512 (the project-wide default, see main/'s
# sdkconfig) is already generous and left as-is.
