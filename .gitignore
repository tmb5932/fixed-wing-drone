.pytest_cache/
__pycache__/

# esp-idf built binaries
build/
build_*_*/
sdkconfig.old

*.o
*.d
*.elf
*.bin
*.hex
*.map
*.a

# Component Manager Stuff
.component_hash
managed_components/

# IDE specific
.vscode/
.clangd/
.ccls-cache/

# idf-ci build run output
build_summary_*.xml
app_info_*.txt
size_info_*.txt

# pytest-embedded log folder
pytest_embedded_log/

# idf-component-manager output
dependencies.lock

.DS_Store

# SITL host build output
sitl/*.exe
sitl/output.csv
sitl/nav_output.csv
sitl/.venv/

.cache/
**/*.lck
.history/

# KiCad-generated noise, across every board project under kicad/ (not just
# flight-controller) -- all regenerable from the tracked design files, none
# of it meaningful to keep in git.
kicad/**/*-backups/
kicad/**/gerber
# Trailing slash matters: a directory-level match keeps git from descending
# into analysis/ at all, so a regenerated analysis/.gitignore's own
# "!manifest.json" override (kicad-happy's own convention) can't re-track
# it -- a glob like "analysis/*" doesn't have this property, since git still
# evaluates the nested .gitignore for paths inside a glob-excluded dir.
kicad/**/analysis/
kicad/**/production
kicad/**/fp-info-cache
kicad/**/drc*.json
kicad/**/erc*.json
kicad/**/_autosave-*
kicad/**/*.kicad_sch-bak
kicad/**/*.kicad_pcb-bak

# Datasheet-sync tracking cache (which parts were fetched, pass/fail,
# timestamps) -- not part of the design; keep the actual datasheet PDFs.
kicad/**/datasheets/manifest.json
