#ifndef CONFIG_LINK_SECRETS_H
#define CONFIG_LINK_SECRETS_H

// Copy this file to config_link_secrets.h (gitignored) and fill in real
// values before building. Both this file's values and the basestation's
// link_secrets.h must agree (same PMK/LMK on both sides, and each side's
// peer MAC must be the OTHER device's real MAC).
//
// ESP-NOW's encrypted peer entries must be unicast -- a broadcast peer can't
// be encrypted. That means both devices' real MAC addresses need to be known
// ahead of time:
//   1. Flash each board once with any firmware that logs its own MAC, e.g.
//      a temporary line in app_main() with esp_wifi_get_mac(WIFI_IF_STA, mac)
//      (call after esp_wifi_init(), before esp_wifi_start() is fine).
//   2. Note both MACs down.
//   3. Fill in CONFIG_LINK_PEER_MAC below with the BASESTATION's MAC.
//   4. Reflash the FC with this file in place.
// The basestation side does the mirror image with the FC's MAC.

// Wi-Fi channel both devices communicate on. Must match on both sides.
#define CONFIG_LINK_WIFI_CHANNEL (6)

// 16-byte primary master key, used to encrypt the LMK exchange. Pick any 16
// bytes; must match the basestation's link_secrets.h exactly.
#define CONFIG_LINK_PMK { 'C','h','a','n','g','e','M','e','1','6','B','y','t','e','s','!' }

// 16-byte local master key for this peer's encrypted link. Must match the
// basestation's link_secrets.h exactly.
#define CONFIG_LINK_LMK { 'C','h','a','n','g','e','M','e','T','o','o','1','6','B','y' }

// The BASESTATION's real STA MAC address (see step 1-2 above).
#define CONFIG_LINK_PEER_MAC { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

#endif // CONFIG_LINK_SECRETS_H
